{
  "name": "auto-sheets",
  "version": "0.1.0",
  "description": "A small software factory that replicates the cell and formula behaviour of Excel for the web.",
  "private": true,
  "type": "module",
  "bin": {
    "factory": "./src/cli.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "factory": "node src/cli.ts",
    "typecheck": "tsc",
    "test": "node --test \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@commander-js/extra-typings": "15.0.0",
    "commander": "15.0.0",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "typescript": "7.0.2"
  }
}
