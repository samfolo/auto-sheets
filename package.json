{
  "name": "auto-sheets",
  "version": "0.1.0",
  "description": "A small software factory that replicates the cell and formula behaviour of Excel for the web.",
  "private": true,
  "type": "module",
  "bin": {
    "factory": "./src/main.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "factory": "node src/main.ts",
    "typecheck": "tsc",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@commander-js/extra-typings": "15.0.0",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "commander": "15.0.0",
    "pino": "10.3.1",
    "playwright": "1.63.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
