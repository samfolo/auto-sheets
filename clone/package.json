    "tsx": "4.20.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
